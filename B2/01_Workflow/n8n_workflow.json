      "id": "e4de5f45-5712-40b1-8e12-babcf02c14f3",
      "name": "Is New?",
      "disabled": true
    },
    {
      "parameters": {
        "jsCode": "const results = [];\n\nfor (let index = 0; index < items.length; index++) {\n  try {\n    const item = items[index];\n    const resp = item.json.body || item.json;\n\n    // 1. LLM 응답 추출\n    if (resp.error) {\n      console.error(`Item ${index} API 에러 발생:`, resp.error.message || resp.error);\n      continue;\n    }\n    const message = resp.choices?.[0]?.message?.content;\n    if (!message) continue;\n\n    // 2. 마크다운/잡텍스트 제거 후 중괄호 본체만 추출\n    let cleaned = message.replace(/\\`{3}(?:json)?/gi, '').trim();\n    const jsonMatch = cleaned.match(/\\{[\\s\\S]*\\}/);\n    if (jsonMatch) cleaned = jsonMatch[0];\n\n    const parsed = JSON.parse(cleaned);\n\n    // 3. 원본 메타 추적\n    let rss = {};\n    try {\n      const m = $('Remove Duplicates').itemMatching(index);\n      rss = (m && m.json) ? m.json : ($('Remove Duplicates').all()[index]?.json ?? {});\n    } catch (e) {\n      rss = $('Remove Duplicates').all()[index]?.json ?? {};\n    }\n\n    // 4. 추적 키 확보\n    const source_url = rss.link || rss.guid || '';\n    if (!source_url) {\n      console.warn(`Item ${index}: source_url 없음 → 스킵`);\n      continue;\n    }\n\n    // [강화된 로직] LLM이 \"미정\", \"정보 없음\" 등으로 분석을 포기한 경우 완벽 차단\n    const badTitle = !parsed.title_kr || parsed.title_kr.includes('미정') || parsed.title_kr.includes('정보 없음');\n    const badSummary = parsed.summary_kr && (\n      parsed.summary_kr.includes('제공되지 않았습니다') || \n      parsed.summary_kr.includes('정보가 없어') || \n      parsed.summary_kr.includes('요약할 수 없') ||\n      parsed.summary_kr.includes('정보 없음') ||\n      parsed.summary_kr.length < 20 // 20자 미만이면 의미 없는 요약으로 간주\n    );\n\n    if (badTitle || badSummary) {\n      console.warn(`Item ${index}: LLM 분석 실패(정보 없음 패턴 감지) → 스킵`);\n      continue;\n    }\n\n    // 5. 결과 객체\n    results.push({\n      json: {\n        title_kr: parsed.title_kr || '',\n        summary_kr: parsed.summary_kr || '',\n        tags: Array.isArray(parsed.tags) ? parsed.tags.join(', ') : (parsed.tags || ''),\n        source_url,\n        pub_date: rss.isoDate || rss.pubDate || '',\n      },\n      pairedItem: { item: index },\n    });\n\n  } catch (error) {\n    console.error(`Item ${index} 파싱 실패:`, error.message);\n  }\n}\n\nreturn results;"
      },
