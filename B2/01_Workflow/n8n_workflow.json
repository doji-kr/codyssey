        "url": "https://openrouter.ai/api/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"google/gemini-2.5-flash-lite\",\n  \"response_format\": { \"type\": \"json_object\" },\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"너는 반려견 전문가야. 영문 기사를 분석해서 title_kr, summary_kr, tags 세 키만 가진 JSON 객체로만 답변해. summary_kr은 반드시 3문장(3줄) 이내로 작성해. 코드펜스나 다른 텍스트는 절대 붙이지 마.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": {{ JSON.stringify(\"Title: \" + $json.title + \"\\n\\nContent: \" + $json.contentSnippet) }}\n    }\n  ]\n}",
        "options": {
          "batching": {
            "batch": {
              "batchInterval": 5000
            }
          }
        }
      },
      "id": "883a9a53-efdb-4d15-a40d-1d1b1eb71bba",
      "name": "OpenClaw AI Processing",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -144,
        1088
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "credentials": {
        "httpBearerAuth": {
          "id": "ZfbgUSqjFdg8Rcs2",
          "name": "Bearer Auth account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const out = [];\nconst parsed = $('Parse JSON Backup').all();\n\nfor (let i = 0; i < items.length; i++) {\n  const resp = items[i].json;\n  const img = resp.choices?.[0]?.message?.images?.[0];\n  const dataUrl = img?.image_url?.url || img?.url;\n  if (!dataUrl) { continue; }\n\n  const buffer = Buffer.from(dataUrl.split(',').pop(), 'base64');\n\n  out.push({\n    json: parsed[i].json,\n    binary: {\n      thumbnail: await this.helpers.prepareBinaryData(buffer, `thumb_${i}.png`, 'image/png'),\n    },\n    pairedItem: { item: i },\n  });\n}\n\nreturn out;"
      },
